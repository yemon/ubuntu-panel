# VPS Manager configuration
# Copy this file to ".env" and change the values below.
#   cp .env.example .env

# Login credentials for the dashboard
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# Secret key used to sign session cookies.
# Use a long random value, e.g.:  python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-long-random-string

# Optional MySQL credentials for database backup/restore.
# Leave both blank to use root socket authentication via sudo (the Ubuntu
# default — works out of the box). Set them only if you use a dedicated
# MySQL user with a password.
#MYSQL_USER=
#MYSQL_PASSWORD=
